{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "Haiere — Hajir Studio",
  "short_name": "Haiere",
  "description": "Free web tools, AI chatbots (Raia & Kirana), open-source projects, mini games, and original music by Hajir Muhaajir.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "theme_color": "#0A192F",
  "background_color": "#0A192F",
  "categories": [
    "productivity",
    "utilities",
    "developer",
    "music",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "https://i.postimg.cc/pL6Gc9p7/IMG-20261101-100625.jpg",
      "sizes": "any",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Hero, Beat Tools grid, and Signature Music player"
    }
  ],
  "shortcuts": [
    {
      "name": "Beat Tools",
      "short_name": "Tools",
      "description": "Browse every free web tool",
      "url": "/?source=pwa#tools",
      "icons": [
        {
          "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
          "sizes": "96x96",
          "type": "image/webp"
        }
      ]
    },
    {
      "name": "AI & Bots",
      "short_name": "Bots",
      "description": "Chat with Raia and Kirana",
      "url": "/?source=pwa#ai-bots",
      "icons": [
        {
          "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
          "sizes": "96x96",
          "type": "image/webp"
        }
      ]
    },
    {
      "name": "Games",
      "short_name": "Games",
      "description": "Play Chess, Loveyou, and more in the browser",
      "url": "/?source=pwa#games",
      "icons": [
        {
          "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
          "sizes": "96x96",
          "type": "image/webp"
        }
      ]
    },
    {
      "name": "Music",
      "short_name": "Music",
      "description": "Listen to Signature Music by Haiere",
      "url": "/?source=pwa#music",
      "icons": [
        {
          "src": "https://i.postimg.cc/VLrVFjF1/haieresignaturebiru.webp",
          "sizes": "96x96",
          "type": "image/webp"
        }
      ]
    },
    {
      "name": "About",
      "short_name": "About",
      "description": "About Hajir — developer, AI builder, musician",
      "url": "/?source=pwa#about",
      "icons": [
        {
          "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
          "sizes": "96x96",
          "type": "image/webp"
        }
      ]
    },
    {
      "name": "Contact",
      "short_name": "Contact",
      "description": "Send a message to Hajir",
      "url": "/?source=pwa#contact",
      "icons": [
        {
          "src": "https://i.postimg.cc/8PJ0bhb1/H-haiere.webp",
          "sizes": "96x96",
          "type": "image/webp"
        }
      ]
    }
  ]
}
